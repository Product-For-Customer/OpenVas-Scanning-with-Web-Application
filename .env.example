# ──────────────────────────────────────────────────────────────
# Local development environment for OpenVAS Scanning Web App
# Copy to .env and fill in the secrets: cp .env.example .env
# ──────────────────────────────────────────────────────────────

# ── Backend (Go / Gin) ─────────────────────────────────────────
PORT=9000
# Public base URL of the backend, used to build report download links
PATH_API_URL=http://localhost:9000
# Extra CORS origins (http://localhost:5173 and http://frontend are always allowed)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:9000

# ── Secrets (randomly generated for this machine) ──────────────
# Backend refuses to start if JWT_SECRET is empty.
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
AUTOMATION_TOKEN=CHANGE_ME_openssl_rand_hex_24
ZAP_API_KEY=CHANGE_ME_openssl_rand_hex_16

# ── GVM / OpenVAS (gvmd GMP over unix socket) ──────────────────
# Defaults to admin/admin if unset; set explicitly to silence the warning.
GVM_USERNAME=admin
GVM_PASSWORD=admin
GVM_SOCKET_PATH=/run/gvmd/gvmd.sock

# ── Frontend (Vite build args) ─────────────────────────────────
VITE_BACKEND_URL=http://localhost:9000
VITE_OPENVAS_URL=http://localhost:9392

# ── Optional ───────────────────────────────────────────────────
# NVD API key raises the rate limit for CVE enrichment (leave blank to use anonymous).
NVD_API_KEY=
